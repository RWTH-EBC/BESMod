within BESMod.Systems.Demand.Building.Components;
package TEASERBuildingSingleZone "Reduced order elements with room resolved interior heat transfer, for TEASERThermalSingleZone"
  extends Modelica.Icons.Package;

  annotation (Documentation(info="<html>
<p>
  Copy of AixLib's reduced order thermal zone and RC elements, extended by
  the parameters of
  <a href=\"modelica://BESMod.Systems.Demand.Building.RecordsCollection.BuildingSingleZoneBaseRecord\">BuildingSingleZoneBaseRecord</a>
  that carry the rooms' inner geometry into a single merged zone. See
  <a href=\"modelica://BESMod.Systems.Demand.Building.TEASERThermalSingleZone\">TEASERThermalSingleZone</a>
  for what they change.
</p>
</html>"));
end TEASERBuildingSingleZone;
