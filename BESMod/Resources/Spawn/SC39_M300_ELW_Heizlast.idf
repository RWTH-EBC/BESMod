Zone,
    EG_WohnenKochenEssen,     !- Name
    0,                        !- Direction of Relative North {deg}
    0,                        !- X Origin {m}
    0,                        !- Y Origin {m}
    0,                        !- Z Origin {m}
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height {m}
    103.2564,                 !- Volume {m3}
    autocalculate,            !- Floor Area {m2}
    ,                         !- Zone Inside Convection Algorithm
    ,                         !- Zone Outside Convection Algorithm
